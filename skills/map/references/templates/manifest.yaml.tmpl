id: "{{id}}"
title: "{{title}}"
class: feature  # feature | bug | small | epic | refactor
phase: architect  # refactor | architect | specify | plan | implement | decomposed | archive-ready
language: ""  # idiom-pack filename stem, e.g. rust, go, typescript; leave empty for language-agnostic

# parent: "{{epic-id}}"   # uncomment for child changes; set to the epic's change ID
# children: []            # uncomment for epic manifests; populated by epic-split.mjs

# Refactor class only (use change-new.mjs --class refactor to scaffold):
# refactor_mode: execute        # execute | audit-only
# refactor_selected_ids: []     # user-approved RF-NNN opportunity IDs from refactor.md
# For a refactor, approvals are { refactor, implement, docs } and artifacts is { refactor: refactor.md }.

approvals:
  architect:  pending
  specify:    pending
  plan:       pending
  implement:  pending
  docs:       pending

artifacts:
  change_brief:  change-brief.md
  architecture: architecture.md
  decisions:    decisions.md
  plan:         plan.md

context_targets:
  - CONTEXT.md
  # Add component CONTEXT.md files this change touches:
  # - src/<component>/CONTEXT.md

kickbacks: []
# kickback entry shape:
# - type:       defect | amendment
#   phase:      specify | plan | implement
#   at:         <iso-timestamp>
#   missed:     "What the upstream spec should have caught"
#   resolution: "What was decided to resolve it"
#   impact:     specify | plan | implementation
#   invalidated_approvals: "specify,plan"
#   restart_phase: specify

# Record this before a cancellation archive:
# archive:
#   outcome: cancelled
#   reason: "Why this change will not continue"
