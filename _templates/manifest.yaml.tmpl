id: "{{id}}"
title: "{{title}}"
class: feature  # feature | bug | small | epic | refactor
stage: architect  # refactor | architect | specify | plan | implement | done
language: ""  # idiom-pack filename stem, e.g. rust, go, typescript; leave empty for language-agnostic
checkpoint_epoch: 0  # integer; kickbacks and upstream gate resets increment this
# implementation_contract_digest: "<sha256>"  # normalized plan/refactor contract captured by gate approval
# refactor_mode: execute | audit-only  # set by the refactor selection gate
# refactor_selected_ids: [RF-001]  # execute mode only; exact approved inventory

# parent: "{{epic-id}}"   # uncomment for child changes; set to the epic's change ID
# children: []            # uncomment for epic manifests; populated by epic-split.mjs

gates:
  # refactor: pending  # pending | approved; use only for class: refactor
  architect:  pending
  specify:    pending
  plan:       pending
  implement:  pending
  docs:       pending

artifacts:
  architecture: architecture.md
  decisions:    decisions.md
  plan:         plan.md
  # Class refactor instead uses: refactor.md, implementation-units.json, implementation-state.json, reviews/

context_targets:
  - CONTEXT.md
  # Add component CONTEXT.md files this change touches:
  # - src/<component>/CONTEXT.md

kickbacks: []
# kickback entry shape:
# - type:       defect | amendment
#   stage:      specify | plan | implement
#   at:         <iso-timestamp>
#   missed:     "What the upstream spec should have caught"
#   resolution: "What was decided to resolve it"
